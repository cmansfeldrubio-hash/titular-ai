# Copiar a apps/web/.env.local y completar. Ninguna variable lleva NEXT_PUBLIC_.
# Cifra la cookie de sesión de Auth.js (genera una con: npx auth secret)
AUTH_SECRET=
# Cliente OAuth de Google (tipo aplicación web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# URL base: http://localhost:3000 en local, el dominio fijo en producción
AUTH_URL=
# Cuentas que pueden iniciar sesión, separadas por coma
ALLOWED_EMAILS=
# Casilla de prueba desde la que se leen y envían correos
DEMO_INBOX_ADDRESS=

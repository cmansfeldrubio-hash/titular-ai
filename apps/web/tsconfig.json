{
  "extends": "@ley/config/tsconfig.react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "astryx-themes.js"],
  "exclude": ["node_modules", ".next", "playwright-report", "test-results"]
}

    "test": "turbo run test",
    "test:e2e": "pnpm --filter web test:e2e",
    "gen:fuentes": "turbo run gen:fuentes",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
